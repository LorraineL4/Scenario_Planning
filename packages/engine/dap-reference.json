  "formulas": {
    "baseline_full": {
      "formula": "distribution_baseline × (1 + price_elasticity_impact) × (1 + misc_impact_pct) × seasonality_index",
      "dependencies": ["acv_pct (scenario input)", "Sales Rates (elasticity)", "seasonality_index (row 7)"]
    },
    "price_elasticity_impact": {
      "formula": "IF(price_impact_manual IS SET, price_impact_manual, (new_edp / current_edp)^elasticity − 1)",
      "elasticity_source": "observed: LN(new_rate/current_rate) / LN(new_price/current_price); else constant_elasticity from Sales Rates table"
    },
    "promo_units": {
      "formula": "(weeks_event_promo1 × baseline_full × (1 + lift_promo1)) + (weeks_event_promo2 × baseline_full × (1 + lift_promo2))"
    },
    "incremental_units": {
      "formula": "(weeks_event_promo1 × baseline_full × lift_promo1) + (weeks_event_promo2 × baseline_full × lift_promo2)"
    },
    "non_promo_units": {
      "formula": "(weeks_in_period − weeks_event_promo1 − weeks_event_promo2) × baseline_full"
    },
    "unit_sales": {
      "formula": "non_promo_units + promo_units"
    },
    "gross_sales": {
      "formula": "unit_sales × gross_price"
    },
    "everyday_net_cost": {
      "formula": "gross_price × (1 + upcharge_dist_pct) − edlp_direct − (edlp_mcb_pct × gross_price × (1 + upcharge_dist_pct))",
      "note": "MCB credit uses DISTRIBUTOR upcharge"
    },
    "per_unit_promo_cost_to_mfr": {
      "formula": "scan_promo + (coupon_cost_promo × coupon_redemption_promo) + (mcb_promo_pct × gross_price × (1 + upcharge_cat_pct))",
      "note": "MCB cost uses CATALOG upcharge — different from credit to retailer"
    },
    "per_unit_credit_to_retailer": {
      "formula": "scan_promo + (coupon_discount_promo × coupon_redemption_promo) + (mcb_promo_pct × gross_price × (1 + upcharge_dist_pct))",
      "note": "MCB credit uses DISTRIBUTOR upcharge"
    },
    "everyday_retail_margin_pct": {
      "formula": "1 − (everyday_net_cost / base_price)"
    },
    "promo_retail_margin_pct": {
      "formula": "1 − ((everyday_net_cost − per_unit_credit_to_retailer) / (price_promo − coupon_discount_promo × coupon_redemption_promo))"
    },
    "buyout_spend": {
      "formula": "buyout_weeks × baseline_full × buyout_amount_per_unit"
    },
    "base_profit": {
      "formula": "base_units × (gross_price − edlp_cost_per_unit − cogs)"
    },
    "incremental_profit_after_trade": {
      "formula": "incremental_gross − (incremental_units × cogs) − incremental_spend"
    },
    "profit_after_working_spend": {
      "formula": "base_profit + incremental_profit_after_trade − brick − distributor_working_spend − digital_sales_spend − other_spend"
    },
    "profit_after_total_spend": {
      "formula": "profit_after_working_spend − terms_spoils_spend − slotting_prob_weighted"
    },
    "net_sales": {
      "formula": "gross_sales − defined_trade"
    },
    "defined_trade": {
      "formula": "sum of components selected by Config.net_sales_trade_components",
      "components": [
        "retailer_working_spend",
        "distributor_working",
        "digital_sales_spend",
        "other_spend",
        "terms_spoils_spend",
        "slotting"
      ],
      "default": "all six components (equals total_spend_all)"
    },
    "distributor_working_spend": {
      "formula": "gross_sales × distributor_program_pct",
      "source": "Account Info D14"
    },
    "digital_sales_spend": {
      "formula": "gross_sales × digital_sales_pct",
      "source": "Account Info D15"
    },
    "other_spend": {
      "formula": "gross_sales × other_program_pct",
      "source": "Account Info D16"
    },
    "terms_spoils_spend": {
      "formula": "gross_sales × terms_spoils_pct",
      "source": "Account Info D13",
      "note": "Non-working trade — excluded from retailer margin calculation"
    },
    "promo_efficiency": {
      "formula": "incremental_gross / incremental_spend"
    },
    "promo_roi": {
      "formula": "incremental_profit_after_trade / incremental_spend"
    },
    "allin_trade_rate": {
      "formula": "total_spend_all / gross_sales"
    }
  },

  "price_rounding": {
    "D": { "name": "Dimes",   "formula": "MROUND(price, 0.1) - 0.01" },
    "Q": { "name": "Quarters","formula": "VLOOKUP against Helpers quarters table (columns A-B)" },
    "H": { "name": "Halves",  "formula": "MROUND(price, 0.5) - 0.01" },
    "Do":{ "name": "Dollars", "formula": "MROUND(price, 1.0) - 0.01" }
  },

