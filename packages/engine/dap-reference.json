        "D4":  { "field": "sales_manager",          "type": "string" },
        "D5":  { "field": "sales_channel",          "type": "string", "example": "WFM" },
        "D6":  { "field": "pricing_strategy",       "type": "string" },
        "D7":  { "field": "primary_distributor",    "type": "string", "example": "UNFI" },
        "D8":  { "field": "secondary_distributor",  "type": "string" },
        "D12": { "field": "number_of_stores",       "type": "integer" },
        "D13": { "field": "terms_spoils_pct",       "type": "percent", "example": 0.046 },
        "D14": { "field": "distributor_program_pct","type": "percent", "example": 0.06 },
        "D15": { "field": "digital_sales_pct",      "type": "percent" },
        "D16": { "field": "other_program_pct",      "type": "percent" },
        "G4":  { "field": "tpr_fee",                "type": "currency" },
        "G5":  { "field": "tpr_length_weeks",       "type": "integer" },
        "G6":  { "field": "ad_fee",                 "type": "currency" },
        "G7":  { "field": "ad_length_weeks",        "type": "integer" },
        "G8":  { "field": "min_pct_to_execute",     "type": "percent" },
        "G9":  { "field": "can_execute_scans",      "type": "boolean" }
      }
    },

    "Distribution": {
      "type": "input",
      "purpose": "Per-SKU velocity data, pipeline, and slotting by period. ACV % is now a scenario input (see product_group_row_map.inputs.distribution).",
      "structure": "one row per SKU",
      "key_columns": {
        "A":    { "field": "sku_name" },
        "AV-BH":{ "field": "unknown_tbd", "note": "not ACV, not per-period probability — needs clarification" },
        "BV-CH":{ "field": "per_period_distribution_probability", "periods": "P01-P13" },
        "AD":   { "field": "new_distribution_change_probability" },
        "AF":   { "field": "pipeline_cases_per_store" },
        "AG":   { "field": "pipeline_lead_time_periods" },
        "AI":   { "field": "new_stores_count" },
        "AJ":   { "field": "units_per_case" },
        "AM":   { "field": "slotting_lump_sum" },
        "AN":   { "field": "slotting_per_store" },
        "AO":   { "field": "slotting_cases_per_store" }
      },
      "derived": {
        "tdp": "scenario.acv_pct × number_of_stores",
        "distribution_baseline": "velocity[sku] × TDP"
      }
    },

    "Sales Rates": {
      "type": "lookup",
      "purpose": "Maps Channel × Product × Price Point to Sales Rate and Constant Elasticity",
      "row_count": 527,
      "columns": {
        "A": "channel_of_trade",
        "B": "product_group",
        "C": "rounding_type",
        "D": "price_point",
        "E": "sales_rate",
        "F": "constant_elasticity"
      },
      "lookup_formula": "SUMIFS(sales_rates[E], [B], pg_name, [D], rounded_price, [A], channel)",
      "notes": "Sales rate is a normalized index (1.0 = base at lowest listed price). Constant elasticity is fixed per product (e.g., -0.96 for COR 1L EVOO)."
    },

    "Product Group (template)": {
      "type": "calculation",
      "purpose": "Per-SKU financial model for all 12 fiscal periods",
      "dimensions": "237 rows × 36 columns",
      "period_columns": "E=P01 through P=P12, Q-S=P13-P15, T=Annual",
      "header_kpis": {
        "N2": "annual_gross_sales",
        "N3": "net_effective_price",
        "T2": "account_allin_trade_rate",
        "T3": "product_allin_trade_rate",
        "T4": "product_retailer_working_ts"
      }
    },

    "Total": {
      "type": "aggregation",
      "purpose": "Flat database (~15,988 rows). Each row = PG × Metric × Period → value. Source for Account Roll-up.",
      "row_structure": "product_group | metric_name | period | value"
    },

    "Account Roll-up": {
      "type": "output",
      "purpose": "Monthly P&L across all SKUs using SUMIFS on Total sheet",
      "key_metrics": [
        "unit_sales", "gross_sales", "working_spend", "ts_spend",
        "distributor_spend", "slotting", "net_sales",
        "profit_after_working_spend", "profit_after_total_spend",
        "total_retail_dollars", "total_retail_margin", "retail_margin_pct"
      ]
    }
  },

