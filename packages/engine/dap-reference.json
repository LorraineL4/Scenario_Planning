    "note": "Extracted by manual analysis. Do not re-read the original Excel. See DAP_METHODOLOGY.md for full formula documentation.",
    "fiscal_year_start_month": "July",
    "fiscal_year_start_period": "P01",
    "week_pattern": [4, 4, 5, 4, 4, 5, 4, 4, 5, 4, 4, 5],
    "total_weeks": 52
  },

  "fiscal_calendar": {
    "P01": { "month": "July",      "weeks": 4, "col": "E" },
    "P02": { "month": "August",    "weeks": 4, "col": "F" },
    "P03": { "month": "September", "weeks": 5, "col": "G" },
    "P04": { "month": "October",   "weeks": 4, "col": "H" },
